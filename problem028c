#include <stdio.h>
#include <string.h>

struct Student{
    char name[100];
    int age,marks;
};

int main(){
    struct Student s;
    printf("Name : ");
    scanf("%s",&s.name);
    printf("Age : ");
    scanf("%d",&s.age);
    printf("Marks : ");
    scanf("%d",&s.marks);
    printf("%s, %d, %d,",s.name,s.age,s.marks);
}
